# =============================================================
# Timber Management System - Frontend environment variables
# -------------------------------------------------------------
# 1. Copy this file:   cp .env.example .env.local
# 2. Fill in the values in .env.local (NOT in this file)
# 3. Never commit .env.local - it is in .gitignore
#
# Variables starting with NEXT_PUBLIC_ are sent to the browser.
# Never put passwords, secrets or private keys in them.
# Values marked <TBD> will be provided by the project lead.
# =============================================================

# ---------- App ----------
NEXT_PUBLIC_APP_NAME="Timber Management System"
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development            # development | test | production

# ---------- Backend API ----------
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1   # <TBD> backend base URL
NEXT_PUBLIC_API_TIMEOUT_MS=30000

# ---------- Authentication ----------
# Session/JWT is issued by the backend. Cookie name must match the backend.
NEXT_PUBLIC_AUTH_COOKIE_NAME=tms_session          # <TBD>
NEXT_PUBLIC_SESSION_TIMEOUT_MINUTES=30

# ---------- Maps & GPS (sites and trees map view) ----------
NEXT_PUBLIC_MAPS_API_KEY=                         # <TBD>
NEXT_PUBLIC_MAP_DEFAULT_LAT=7.8731
NEXT_PUBLIC_MAP_DEFAULT_LNG=80.7718
NEXT_PUBLIC_MAP_DEFAULT_ZOOM=8

# ---------- Localization ----------
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_SUPPORTED_LOCALES=en,si,ta
NEXT_PUBLIC_CURRENCY=LKR
NEXT_PUBLIC_TIMEZONE=Asia/Colombo
NEXT_PUBLIC_DATE_FORMAT=dd/MM/yyyy
NEXT_PUBLIC_VOLUME_UNIT=m3                        # m3 | cft

# ---------- File uploads (permit documents, tree photos) ----------
NEXT_PUBLIC_MAX_UPLOAD_MB=5
NEXT_PUBLIC_IMAGE_MAX_WIDTH_PX=1600               # photos are compressed on the device

# ---------- Offline field mode (PWA) ----------
NEXT_PUBLIC_ENABLE_PWA=true
NEXT_PUBLIC_OFFLINE_DB_NAME=tms-offline
NEXT_PUBLIC_SYNC_INTERVAL_SECONDS=60

# ---------- Feature flags ----------
NEXT_PUBLIC_ENABLE_CUSTOMER_PORTAL=false          # Phase 2
NEXT_PUBLIC_ENABLE_EXPORT_SALES=false             # Phase 3
