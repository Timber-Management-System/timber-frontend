# --- Security: do not remove without admin approval ---

# Don't run package install scripts (preinstall/postinstall).
# Most npm malware (e.g. token-stealing worms) runs through these scripts.
# "npm run dev", "npm run build" etc. still work normally.
ignore-scripts=true

# Save exact versions (no ^ or ~), so a new malicious release
# is never pulled in automatically.
save-exact=true

fund=false
